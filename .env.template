# Copy to .env. Compose reads this file for every stack (dev and production).

# --- always required ----------------------------------------------------------
POSTGRES_KEYCLOAK_PASSWORD=xxxxxx
KC_BOOTSTRAP_ADMIN_PASSWORD=xxxxxxx
POSTGRES_HAPI_PASSWORD=xxxxxx

# --- production (docker-compose.prod.yml) -------------------------------------
# Public address of the system; Caddy's site address, Keycloak's hostname, the token
# issuer the gateway trusts, and the realm's allowed redirect URI all derive from it.
# https:// gets an automatic Let's Encrypt certificate (DNS must already resolve here).
# EMR_PUBLIC_URL=https://emr.example.com

# Keycloak realm sslRequired. `external` for https deployments, `none` only for an
# http:// EMR_PUBLIC_URL on a trusted network.
# EMR_SSL_REQUIRED=external

# Password given to the eight seed accounts on first realm import. Dev default is
# `password`; never leave that on a reachable server. Rotate per user in Keycloak after
# the first sign-in.
# EMR_SEED_PASSWORD=choose-a-long-password

# Frontend image to run. Leave unset to build locally; set to pull a CI-built image.
# FRONTEND_IMAGE=ghcr.io/nawitech/nawi-beda-emr:latest

# HAPI image tag pinned by the production overlay (dev uses :latest).
# HAPI_IMAGE_TAG=v8.10.0-3
